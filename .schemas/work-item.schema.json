{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalised work item (GitHub Issues, Jira, Azure DevOps)",
  "type": "object",
  "required": ["provider", "id", "title"],
  "properties": {
    "provider": { "enum": ["github", "jira", "ado", "memory"] },
    "id": { "type": "string", "description": "Native id, or a full reference (ado:123) when returned by WorkItemRouter" },
    "ref": { "type": "string" },
    "type": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string", "description": "Plain text (converted from HTML or ADF)" },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
    "state": { "type": ["string", "null"] },
    "parentId": { "type": ["string", "null"] },
    "assignee": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "url": { "type": "string" }
  }
}
