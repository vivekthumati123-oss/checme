{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "unit-agent: config check",
      "type": "shell",
      "command": "{{rawNodeCommand}}",
      "args": ["{{cliEntry}}", "config", "check"],
      "problemMatcher": []
    },
    {
      "label": "unit-agent: doctor",
      "type": "shell",
      "command": "{{rawNodeCommand}}",
      "args": ["{{cliEntry}}", "local", "doctor", "--full"],
      "problemMatcher": []
    },
    {
      "label": "unit-agent: detect",
      "type": "shell",
      "command": "{{rawNodeCommand}}",
      "args": ["{{cliEntry}}", "local", "detect", "--scope", "${input:unitAgentScope}"],
      "problemMatcher": []
    },
    {
      "label": "unit-agent: validate",
      "type": "shell",
      "command": "{{rawNodeCommand}}",
      "args": ["{{cliEntry}}", "local", "validate"],
      "problemMatcher": []
    },
    {
      "label": "unit-agent: apply (dry run)",
      "type": "shell",
      "command": "{{rawNodeCommand}}",
      "args": ["{{cliEntry}}", "local", "apply"],
      "problemMatcher": []
    },
    {
      "label": "unit-agent: apply (write files)",
      "type": "shell",
      "command": "{{rawNodeCommand}}",
      "args": ["{{cliEntry}}", "local", "apply", "--confirm"],
      "problemMatcher": []
    },
    {
      "label": "unit-agent: status",
      "type": "shell",
      "command": "{{rawNodeCommand}}",
      "args": ["{{cliEntry}}", "local", "status"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "unitAgentScope",
      "type": "pickString",
      "description": "Which changes should get tests?",
      "options": ["branch", "staged", "worktree"],
      "default": "branch"
    }
  ]
}

