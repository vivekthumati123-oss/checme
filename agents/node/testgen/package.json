{
  "name": "@l2/agent-testgen",
  "version": "1.3.0",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "unit-agent": "./dist/cli.js",
    "testgen": "./dist/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config eslint.config.mjs .",
    "format": "prettier --config .prettierrc --ignore-path .prettierignore --write . ../../../tests/unit/agents/node/testgen",
    "format:check": "prettier --config .prettierrc --ignore-path .prettierignore --check . ../../../tests/unit/agents/node/testgen",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts ../../../tests/unit/agents/node/testgen/unit ../../../tests/unit/agents/node/testgen/golden",
    "test:integration": "vitest run --config vitest.config.ts ../../../tests/unit/agents/node/testgen/integration",
    "test:security": "vitest run --config vitest.config.ts ../../../tests/unit/agents/node/testgen/security",
    "test:contract": "vitest run --config vitest.config.ts ../../../tests/unit/agents/node/testgen/contract"
  },
  "dependencies": {
    "@octokit/graphql": "8.2.2",
    "@octokit/rest": "21.1.1",
    "commander": "14.0.3",
    "execa": "9.6.1",
    "fast-xml-parser": "5.12.1",
    "picomatch": "4.0.7",
    "pino": "10.4.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.24.7",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
