# Copy to .env.local (git-ignored). Loaded automatically by wi.mjs and by the L2 agents.
# Existing environment variables always win.

# ---- Copilot SDK (automation runs only)
AGENT_RUNTIME=copilot                 # mock = offline
COPILOT_GITHUB_TOKEN=                 # fine-grained PAT with "Copilot Requests"
L2_DEFAULT_MODEL=                     # optional; l2/<id>.json runtime.model wins

# ---- Target code repository (TestGen, CodeConnect)
GITHUB_TOKEN=                         # fine-grained PAT: Contents, Pull requests, Issues (read & write)
TARGET_REPO=owner/repo                # used when no EVENT_FILE is given

# ---- Work items: default system for bare ids (ado | jira | github)
WORK_ITEM_PROVIDER=ado

# ---- Azure DevOps Boards
ADO_ORG_URL=https://dev.azure.com/<org>
ADO_PROJECT=<project>
ADO_PAT=                              # scope: Work Items (Read & write)
# ADO_CHILD_TYPE=Task
# ADO_ESTIMATE_FIELD=Microsoft.VSTS.Scheduling.RemainingWork

# ---- Jira Cloud (or set JIRA_PAT without JIRA_EMAIL for Data Center)
JIRA_BASE_URL=https://<site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# JIRA_PAT=
# JIRA_PROJECT=LEND
# JIRA_SUBTASK_TYPE=Subtask
# JIRA_AC_FIELD=customfield_10050

# ---- GitHub Issues as work items
WORK_ITEMS_GITHUB_REPO=owner/repo
# WORK_ITEMS_GITHUB_TOKEN=            # falls back to GITHUB_TOKEN
